# Application
APP_NAME=ResearchMesh AI
ENVIRONMENT=development
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=
ALLOW_REGISTRATION=false
CORS_ORIGINS=

# Database / queue
DATABASE_URL=
REDIS_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=

# Research controls
MAX_RESEARCH_SOURCES=12
MAX_PAPERS=5
MAX_PDF_BYTES=15000000
MAX_AGENT_REFLECTIONS=2
MAX_CRITIC_REVISIONS=2
DEFAULT_RESEARCH_DEPTH=standard
MAX_ACTIVE_JOBS_PER_USER=3

# Bootstrap admin
BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_TENANT_NAME=Default Research Team
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend (used outside Docker)
VITE_API_URL=
VITE_WS_URL=
