# Application
APP_NAME=ResearchMesh AI
ENVIRONMENT=development
SECRET_KEY=change-me-with-python-scripts-init-env
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database / queue
DATABASE_URL=postgresql+psycopg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Research controls
MAX_RESEARCH_SOURCES=12
MAX_PAPERS=5
MAX_PDF_BYTES=15000000
MAX_AGENT_REFLECTIONS=2
MAX_CRITIC_REVISIONS=2
DEFAULT_RESEARCH_DEPTH=standard
MAX_ACTIVE_JOBS_PER_USER=3

# Bootstrap admin
BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_TENANT_NAME=Default Research Team
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-This-Password-Now

# Frontend (used outside Docker)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
